# [필수] Telegram Bot Token (BotFather에서 받은 토큰)
BOT_TOKEN=your_telegram_bot_token_here

# [필수] 데이터베이스 경로
# 로컬 개발: ./data/quiz_bot.db
# Railway 운영: /data/quiz_bot.db
DB_PATH=./data/quiz_bot.db

# [선택] GitHub 백업 설정
# GitHub 토큰 (Personal Access Token with repo scope)
# 없으면 백업 기능이 비활성화됨
GITHUB_TOKEN=your_github_token_here

# [선택] GitHub 저장소 (format: owner/repo)
# GITHUB_TOKEN과 함께 설정되어야 백업 활성화
GITHUB_REPOSITORY=minhauser/quiz_bot_backup

# [선택] 백업 간격 (초 단위, 기본값: 300초 = 5분)
# GITHUB_TOKEN이 설정된 경우에만 적용
BACKUP_INTERVAL_SEC=300
