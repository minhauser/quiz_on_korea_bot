# ─── API (NestJS) — local overrides ───
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# ─── Database ───
DATABASE_URL=postgresql://ksp:ksp_password@localhost:5432/ksp_dev?schema=public

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth ───
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_REFRESH_TTL=30d

# ─── OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/callback

# ─── Storage ───
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ksp-media
S3_FORCE_PATH_STYLE=true

# ─── Mail ───
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@koreastudy.app

# ─── AI ───
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS_PER_USER_DAILY=100000

# ─── Observability ───
SENTRY_DSN=
LOG_LEVEL=debug

# ─── Rate limiting ───
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
